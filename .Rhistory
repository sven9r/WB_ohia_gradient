# 1) Scatter + smooth of Shannon vs. elevation, colored (or faceted) by tree species
ggplot(div_df, aes(x = elevation_ft, y = shannon.x, color = shortname)) +
geom_point(alpha = 0.7) +
geom_smooth(method = "lm", se = TRUE) +
labs(
x     = "Elevation (m)",
y     = "Shannon diversity",
color = "Host tree",
title = "Shannon diversity along elevation by host species"
) +
theme_minimal()
# 2) Same for richness
ggplot(div_df, aes(x = elevation_ft, y = richness, color = shortname)) +
geom_point(alpha = 0.7) +
geom_smooth(method = "lm", se = TRUE) +
labs(
x     = "Elevation (m)",
y     = "ZOTU richness",
color = "Host tree",
title = "Richness along elevation by host species"
) +
theme_minimal()
# 3) Test overall trend with a linear model
mod1 <- lm(shannon ~ elevation_ft, data = div_df)
summary(mod1)
# 4) Test for differences among hosts (and elevation × host interaction)
mod2 <- lm(shannon ~ elevation_ft * shortname, data = div_df)
anova(mod2)
