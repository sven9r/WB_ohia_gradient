sr_hightft_reg <-
meta_data %>%
filter(island == "Oahu") |>
filter(commonname == "ʻōhiʻa Lehua") |>
filter(sample_id != "KT1") |>
filter(sample_id != "KA5") |>
drop_na(elevation) |>
mutate(elev_arrow = case_when(
elevation == "high" ~ "\u25B2",  # ▲
elevation == "mid"  ~ "\u25A0",  # ■
elevation == "low"  ~ "\u25BC"   # ▼
)) |>
ggplot() +
geom_text(aes(x = elevation_ft, y = richness,
color = sample_site, label = elev_arrow)) +
geom_smooth(aes(x = elevation_ft, y = richness,
color = sample_site), method = "lm", se = F) +
geom_smooth(aes(x = elevation_ft, y = richness), method = "lm", se = T) +
scale_color_npg() +
scale_fill_npg() +
labs(title = "Species Richness across all ‘Ōhi‘a samples from O‘ahu\nGrouped by elevation",
x = "Elevation",
y = "Species Richness") +
theme_classic() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
