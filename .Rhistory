class(comm)
str(comm)
# 2) Coerce to a plain numeric matrix
comm_mat <- as.matrix(comm)
storage.mode(comm_mat) <- "numeric"
# 3) Explicitly call vegan's diversity (with MARGIN=1 to do rows)
shannon <- vegan::diversity(comm_mat, index="shannon", MARGIN=1)
richness <- vegan::specnumber(comm_mat)  # should work now
# 4) Build your data.frame
div_df <- data.frame(
sample_id = rownames(comm_mat),
richness  = richness,
shannon   = shannon,
stringsAsFactors = FALSE
)
# 5) Join in metadata
div_df <- merge(div_df,
as.data.frame(meta_data, stringsAsFactors = FALSE),
by = "sample_id", all.x = TRUE)
